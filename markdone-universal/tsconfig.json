{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": []
  },
  "include": [
    "./server.ts",
    "./static/**/*.js",
    "./tests/**/*.ts"
  ]
}